DB_NAME=sns_application
DB_USER=sns_user
DB_PASSWORD=change_me_locally
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes

# ---- 画像保存(S3) ----
# ローカル開発ではLocalStackを使うため、下記のデフォルトのままでよい。
STORAGE_S3_BUCKET=sns-application-images-local
STORAGE_S3_REGION=ap-northeast-1

# LocalStackは認証情報を検証しないため、ローカルではダミー値で動く。
# 実AWSに向ける場合は `cd infra && terraform output` で得た値に差し替えること。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# 実AWSを使う場合は、上のキーを実際の値にしたうえで
# STORAGE_S3_ENDPOINT / STORAGE_S3_PUBLIC_ENDPOINT を空にする(未設定なら実AWSに接続する)。

# ---- API仕様書(Swagger UI) ----
# アプリの既定は false(配信しない)。/swagger-ui と /v3/api-docs は認証を経由しないため、
# 公開環境で有効にすると誰でも読める状態になる。
# docker-compose.yml がローカル向けに true を渡すので、通常はここで指定する必要はない。
# ローカルでも無効にしたい場合のみ、下の行のコメントを外して false にする。
# SPRINGDOC_ENABLED=false
