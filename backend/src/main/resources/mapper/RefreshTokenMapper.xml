<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.snsapp.backend.mapper.RefreshTokenMapper">

    <resultMap id="RefreshTokenResultMap" type="com.snsapp.backend.entity.RefreshToken">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tokenHash" column="token_hash"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="revokedAt" column="revoked_at"/>
        <result property="replacedBy" column="replaced_by"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.snsapp.backend.entity.RefreshToken"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <select id="findByTokenHash" resultMap="RefreshTokenResultMap">
        SELECT id, user_id, token_hash, expires_at, revoked_at, replaced_by, created_at
        FROM refresh_tokens
        WHERE token_hash = #{tokenHash}
    </select>

    <!--
        ログアウト等での失効。**replaced_by は入れない。**
        後継が無い = 並行リフレッシュの猶予を与えない、という意味になる。
    -->
    <update id="revoke">
        UPDATE refresh_tokens
        SET revoked_at = now()
        WHERE id = #{id} AND revoked_at IS NULL
    </update>

    <!--
        正規のローテーションでの失効。**後継のIDを記録する。**
        これがあるものだけが、直後の再提示で猶予の対象になる。
    -->
    <update id="revokeReplacedBy">
        UPDATE refresh_tokens
        SET revoked_at = now(), replaced_by = #{replacedById}
        WHERE id = #{id} AND revoked_at IS NULL
    </update>

    <!--
        盗用検知による一括失効。**replaced_by は入れない。**
        入れてしまうと、失効させた直後の再提示が猶予で通り、
        検知が自分で無効化される(V7 のコメント参照)。
    -->
    <update id="revokeAllForUser">
        UPDATE refresh_tokens
        SET revoked_at = now()
        WHERE user_id = #{userId} AND revoked_at IS NULL
    </update>

</mapper>
