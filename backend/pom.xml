<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.snsapp</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend</name>
    <description>SNS application backend</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <jjwt.version>0.13.0</jjwt.version>
        <!--
            Spring Boot 3.5.0 が管理する Testcontainers 1.21.0 は、Docker Engine 29系
            (最小APIバージョン1.40)に対して 400 Bad Request となり接続できず
            "Could not find a valid Docker environment" で失敗する。1.21.4で解消するため引き上げる。
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <aws-sdk.version>2.54.6</aws-sdk.version>
        <!--
            OpenAPI(Swagger UI)生成。springdoc 3.x系はSpring Boot 4向けのため、
            Spring Boot 3.5系に対応する2.x系の最新を使う。
        -->
        <springdoc.version>2.8.14</springdoc.version>
        <!--
            構造化ログ(JSON)のエンコーダ。Spring Bootが管理するのはlogback本体までで
            このアーティファクトはBOM管理外のため、バージョンをここで固定する。
            8.x系はlogback 1.5系(Boot 3.5が使用)を前提とする。
        -->
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 画像はS3に保存する。S3Presigner(署名付きURL生成)もこのアーティファクトに含まれる。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!--
            画像の表示URLをCloudFront経由にするため、署名付きクッキーの生成に使う(CloudFrontUtilities)。
            CloudFrontのAPIを呼ぶためではなく、ローカルで署名を計算するためだけの依存。
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudfront</artifactId>
        </dependency>

        <!--
            コントローラとDTOからOpenAPIドキュメントを生成し、Swagger UIを配信する。
            Swagger UIの静的リソースもこのstarterに同梱されるため、追加の依存は不要。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            ログをJSON1行で出力する(logback-spring.xml の docker プロファイル)。
            アプリはstdoutへ出すだけで送り先を知らないため、Datadog/CloudWatch/Loki等の
            収集エージェントを後から選び直してもアプリ側の変更は要らない。
            アクセスログのフィールド(method/status等)を組み立てる StructuredArguments を
            アプリコードから使うため、runtimeではなくcompileスコープで持つ。
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            MyBatisのXML SQLはPostgreSQL固有(GENERATED ALWAYS AS IDENTITY, ILIKE, 相関サブクエリ)
            のためH2では検証にならない。実際のPostgreSQLコンテナにFlywayを流してテストする。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            画像保存はS3が前提になったため、テストでもS3のAPIが必要になる。
            モックで代用すると署名やキーの扱いの誤りを検出できないため、LocalStackで実際に動かす。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Mockitoのinline mock makerはクラスを実行時に書き換えるためJavaエージェントを必要とする。
                -javaagentの指定が無いとMockitoは動作中のJVMへ自分でエージェントを注入する(self-attach)が、
                この動的ロードはJDK21以降で警告が出るようになり、将来のJDKでは既定で拒否される。
                そうなるとテストが起動しなくなるため、あらかじめ起動時に明示的に読み込ませておく。

                ハードコードを避けるため、jarの実パスはdependency:propertiesが設定する
                ${org.mockito:mockito-core:jar} から得る。mockito-core自体は
                spring-boot-starter-testが推移的に持ち込み、バージョンも親POMが管理しているので
                依存としての明示は不要。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
