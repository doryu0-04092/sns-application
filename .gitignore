# Environment
.env

# Backend (Maven / Java)
backend/target/
*.class
backend/uploads/

# Frontend (Node)
frontend/node_modules/
frontend/dist/

# Terraform
# tfstate には作成したIAMアクセスキーが平文で入り、tfvars にも設定値が入るため必ず除外する。
# なお .terraform.lock.hcl はプロバイダのバージョン固定ファイル(package-lock.json相当)なので
# 意図的に除外しない(コミットする)。
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# パフォーマンステストの生の実行結果(k6のsummary JSONと観測CSV)。
# 要約はdocs/perf-test-report.mdに残すが、裏付けとして生データもコミットする。
perf/results/*.tmp
